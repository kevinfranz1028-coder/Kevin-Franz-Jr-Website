---
layout: broadcast.njk
title: Media
description: "Photography and media production by Kevin Franz Jr. Photography: @shotsbyfranz."
permalink: /media/
active: media
---

{% set reels = [
  { tag: 'MEDIA PRODUCTION I', where: 'Blue Valley Southwest · freshman year · A' },
  { tag: 'MEDIA PRODUCTION II', where: 'Blue Valley Southwest · both semesters · A' },
  { tag: 'PHOTOGRAPHY', where: '@shotsbyfranz on Instagram' },
  { tag: 'INSTAGRAM', where: 'instagram.com/shotsbyfranz' }
] %}

{# ===== HERO — viewfinder ===== #}
<section class="cg-pagehead" style="position:relative; min-height:640px; background:#000; overflow:hidden; border-bottom:8px solid #F5C400;">
  <div style="position:absolute; inset:0;">
    <img src="/images/banner/large_Copy_of_655_A7945_Enhanced_NR_38a7db1e08.jpg" alt="" style="width:100%; height:100%; object-fit:cover; filter:grayscale(0.3) contrast(1.1);">
    <div style="position:absolute; inset:0; background:linear-gradient(180deg, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.78) 70%, #000 100%);"></div>
  </div>
  {# Viewfinder corners #}
  <div style="position:absolute; inset:40px 56px; pointer-events:none; z-index:3;">
    <div style="position:absolute; top:0; left:0; width:32px; height:32px; border-top:2px solid var(--b-green-bright); border-left:2px solid var(--b-green-bright);"></div>
    <div style="position:absolute; top:0; right:0; width:32px; height:32px; border-top:2px solid var(--b-green-bright); border-right:2px solid var(--b-green-bright);"></div>
    <div style="position:absolute; bottom:0; left:0; width:32px; height:32px; border-bottom:2px solid var(--b-green-bright); border-left:2px solid var(--b-green-bright);"></div>
    <div style="position:absolute; bottom:0; right:0; width:32px; height:32px; border-bottom:2px solid var(--b-green-bright); border-right:2px solid var(--b-green-bright);"></div>
  </div>
  <div style="position:absolute; top:24px; left:56px; right:56px; z-index:4; display:flex; justify-content:space-between; align-items:center;">
    <div style="display:flex; align-items:center; gap:16px; font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.14em; color:var(--b-green-bright); text-transform:uppercase;">
      <span>&bull; REC</span><span>1/250</span><span>F2.8</span><span>ISO 1600</span>
    </div>
    <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.14em; color:var(--b-text); text-transform:uppercase;">
      MEDIA PRODUCTION &middot; BVSW
    </div>
  </div>
  <div style="position:absolute; bottom:56px; left:56px; right:56px; z-index:4;">
    <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.14em; color:var(--b-green-bright); text-transform:uppercase; margin-bottom:16px;">&bull; PHOTOGRAPHY &amp; MEDIA</div>
    <h1 style="font-family:'Archivo', sans-serif; font-weight:900; font-size:160px; line-height:0.85; letter-spacing:-0.045em; text-transform:uppercase; margin:0; color:var(--b-text);">
      Through the<br><span style="-webkit-text-stroke:2px var(--b-green-bright); -webkit-text-fill-color:transparent;">lens.</span>
    </h1>
    <p style="font-family:'Inter', sans-serif; font-size:18px; line-height:1.6; color:var(--b-mute); margin-top:24px; max-width:520px;">
      Photography: <a href="https://www.instagram.com/shotsbyfranz/" target="_blank" rel="noopener noreferrer" style="color:var(--b-green-bright);">@shotsbyfranz</a>. Media Production at Blue Valley Southwest.
    </p>
  </div>
</section>

{# ===== REELS ===== #}
<div class="b-section-head">
  <div class="b-section-head-left">
    <span class="b-section-tag">/01 COURSEWORK</span>
    <h2 class="b-section-title">Media class.</h2>
  </div>
</div>
<section style="display:grid; grid-template-columns:repeat(4, 1fr); gap:1px; background:var(--b-line); border-bottom:1px solid var(--b-line);">
  {% for r in reels %}
    <div style="background:{% if loop.first %}var(--b-bg-2){% else %}var(--b-bg){% endif %}; padding:32px 28px; border-top:{% if loop.first %}2px solid var(--b-green-bright){% else %}2px solid transparent{% endif %};">
      <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:20px;">
        <div style="font-family:'JetBrains Mono', monospace; font-size:10px; letter-spacing:0.14em; color:{% if loop.first %}var(--b-green-bright){% else %}var(--b-mute){% endif %}; text-transform:uppercase;">{{ r.tag }}</div>
        <div style="font-family:'JetBrains Mono', monospace; font-size:10px; color:var(--b-mute);">{% if loop.first %}&bull;{% else %}&#9675;{% endif %}</div>
      </div>
      <div style="font-size:15px; color:var(--b-text); line-height:1.5;">{{ r.where }}</div>
    </div>
  {% endfor %}
</section>

{# ===== FEATURED WORK ===== #}
<div class="b-section-head">
  <div class="b-section-head-left">
    <span class="b-section-tag">/02 INSTAGRAM</span>
    <h2 class="b-section-title">@shotsbyfranz.</h2>
  </div>
</div>
<section style="padding:56px; background:var(--b-bg); border-bottom:1px solid var(--b-line);">
  <p style="font-size:18px; line-height:1.6; color:var(--b-mute); max-width:640px; margin:0;">
    Photography: <a href="https://www.instagram.com/shotsbyfranz/" target="_blank" rel="noopener noreferrer" style="color:var(--b-green-bright);">@shotsbyfranz</a>
  </p>
</section>

{# ===== SKILLS ===== #}
<section style="padding:72px 56px; background:var(--b-bg-2); border-bottom:1px solid var(--b-line);">
  <div style="display:grid; grid-template-columns:1fr 1.5fr; gap:64px;">
    <div>
      <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.14em; color:var(--b-green-bright); text-transform:uppercase; margin-bottom:16px;">/03 SKILLS</div>
      <h2 style="font-family:'Archivo', sans-serif; font-weight:900; font-size:64px; line-height:0.9; letter-spacing:-0.03em; text-transform:uppercase; margin:0; color:var(--b-text);">
        Behind<br>the kit.
      </h2>
    </div>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:32px;">
      {% for k in [
        ['SPORTS PHOTOGRAPHY', 'Photography posted at @shotsbyfranz.'],
        ['MEDIA PRODUCTION',    'Media Production I and Media Production II at Blue Valley Southwest. A in each semester.'],
        ['VIDEOGRAPHY',         'Video as part of media production coursework.'],
        ['EDITING',             'Class work in media production.']
      ] %}
        <div>
          <div style="font-family:'Archivo', sans-serif; font-weight:800; font-size:15px; color:var(--b-green-bright); text-transform:uppercase; letter-spacing:0.04em; margin-bottom:8px;">{{ k[0] }}</div>
          <div style="font-size:13px; line-height:1.5; color:var(--b-mute);">{{ k[1] }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{# ===== BOOK A SHOOT ===== #}
<section style="padding:56px; background:var(--b-bg); display:grid; grid-template-columns:1fr auto; gap:32px; align-items:center;">
  <div>
    <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.14em; color:var(--b-green-bright); text-transform:uppercase; margin-bottom:12px;">/04 INSTAGRAM</div>
    <h2 style="font-family:'Archivo', sans-serif; font-weight:900; font-size:48px; line-height:1; letter-spacing:-0.03em; text-transform:uppercase; margin:0; color:var(--b-text);">
      @shotsbyfranz
    </h2>
  </div>
  <a href="https://www.instagram.com/shotsbyfranz/" target="_blank" rel="noopener" style="display:flex; align-items:center; gap:12px; padding:18px 28px; background:var(--b-green-bright); color:var(--b-bg); font-family:'Archivo', sans-serif; font-weight:800; font-size:14px; letter-spacing:0.08em; text-transform:uppercase; text-decoration:none; clip-path:polygon(4% 0, 100% 0, 96% 100%, 0% 100%);">
    FOLLOW ON INSTAGRAM &rarr;
  </a>
</section>
