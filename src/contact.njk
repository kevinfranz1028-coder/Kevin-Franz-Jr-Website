---
layout: broadcast.njk
title: Contact
description: Contact Kevin Franz Jr. — Class of 2028 SG/SF at Shawnee Mission West. Recruiting, scouting, and media inquiries go to the family directly.
permalink: /contact/
active: contact
---

{%- set liveProfiles = player.recruitingProfiles | hasValue("url") -%}

{# ===== HERO ===== #}
<section style="padding:80px 56px; background:var(--b-bg); border-bottom:1px solid var(--b-line);">
  <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.14em; color:var(--b-green-bright); text-transform:uppercase; margin-bottom:24px;">&bull; CONTACT &amp; RECRUITING</div>
  <h1 class="b-contact-h1" style="font-family:'Archivo', sans-serif; font-weight:900; font-size:180px; line-height:0.82; letter-spacing:-0.05em; text-transform:uppercase; margin:0; color:var(--b-text);">
    Get in<br><span style="-webkit-text-stroke:2px var(--b-green-bright); -webkit-text-fill-color:transparent;">touch.</span>
  </h1>
  <p style="font-family:'Inter', sans-serif; font-size:20px; line-height:1.5; color:var(--b-mute); margin-top:40px; max-width:620px;">
    Coaches, scouts, and media &mdash; reach {{ player.parentName }} directly. Stats, film, and recruiting profiles live on the <a href="/basketball/" style="color:var(--b-green-bright);">Basketball page</a>.
  </p>
</section>

{# ===== EMAIL + PHONE CARDS ===== #}
<section class="b-grid b-grid-2 b-grid-bordered">
  <a href="mailto:{{ player.parentEmail }}" style="background:var(--b-bg-2); padding:48px; text-decoration:none; color:var(--b-text); display:flex; flex-direction:column; justify-content:space-between; min-height:260px; border-left:3px solid var(--b-green-bright);">
    <div>
      <div style="font-family:'JetBrains Mono', monospace; font-size:10px; letter-spacing:0.14em; color:var(--b-green-bright); text-transform:uppercase; margin-bottom:14px;">&bull; EMAIL &middot; PRIMARY</div>
      <div style="font-family:'Archivo', sans-serif; font-weight:900; font-size:30px; line-height:1.1; color:var(--b-text); letter-spacing:-0.02em; word-break:break-word;">{{ player.parentEmail }}</div>
    </div>
    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:32px; gap:12px;">
      <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.12em; color:var(--b-mute); text-transform:uppercase;">{{ player.parentName }} &middot; PARENT</div>
      <div style="font-family:'Archivo', sans-serif; font-weight:900; font-size:24px; color:var(--b-green-bright);">&rarr;</div>
    </div>
  </a>
  <a href="tel:{{ player.parentPhone | replace('-','') }}" style="background:var(--b-bg); padding:48px; text-decoration:none; color:var(--b-text); display:flex; flex-direction:column; justify-content:space-between; min-height:260px;">
    <div>
      <div style="font-family:'JetBrains Mono', monospace; font-size:10px; letter-spacing:0.14em; color:var(--b-green-bright); text-transform:uppercase; margin-bottom:14px;">&bull; PHONE</div>
      <div style="font-family:'Archivo', sans-serif; font-weight:900; font-size:44px; line-height:1; color:var(--b-text); letter-spacing:-0.03em;">{{ player.parentPhone }}</div>
    </div>
    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:32px; gap:12px;">
      <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.12em; color:var(--b-mute); text-transform:uppercase;">CALL OR TEXT</div>
      <div style="font-family:'Archivo', sans-serif; font-weight:900; font-size:24px; color:var(--b-green-bright);">&rarr;</div>
    </div>
  </a>
</section>

{# ===== QUICK FACTS FOR COACHES ===== #}
<div class="b-section-head">
  <div class="b-section-head-left">
    <span class="b-section-tag">/01 QUICK FACTS</span>
    <h2 class="b-section-title">The<br>basics.</h2>
  </div>
</div>
<section class="b-grid b-grid-4 b-grid-bordered">
  {% for row in [
    ['CLASS', player.class],
    ['POSITION', player.position],
    ['HEIGHT / WEIGHT', player.height + ' / ' + player.weight + ' lb'],
    ['SHOOTS', player.hand],
    ['HIGH SCHOOL', player.highSchool],
    ['CLUB', player.club + ' · #' + player.clubJersey],
    ['GPA', player.gpa + ' ' + player.gpaLabel],
    ['HOMETOWN', player.location]
  ] %}
    <div style="background:var(--b-bg); padding:26px 24px;">
      <div style="font-family:'JetBrains Mono', monospace; font-size:10px; letter-spacing:0.14em; color:var(--b-mute); text-transform:uppercase;">{{ row[0] }}</div>
      <div style="font-family:'Archivo', sans-serif; font-weight:800; font-size:19px; color:var(--b-text); margin-top:6px; line-height:1.2;">{{ row[1] }}</div>
    </div>
  {% endfor %}
</section>

{# ===== RECRUITING PROFILES ===== #}
<div class="b-section-head">
  <div class="b-section-head-left">
    <span class="b-section-tag">/02 PROFILES</span>
    <h2 class="b-section-title">Find me<br>online.</h2>
  </div>
</div>
<section class="b-grid b-grid-2 b-grid-bordered">
  {% for p in liveProfiles %}
    <a href="{{ p.url }}" target="_blank" rel="noopener" style="background:var(--b-bg); padding:28px 32px; text-decoration:none; color:var(--b-text); display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:24px;">
      <div>
        <div style="font-family:'Archivo', sans-serif; font-weight:900; font-size:20px; color:var(--b-text); text-transform:uppercase; letter-spacing:-0.01em;">{{ p.name }}</div>
        <div style="font-size:13px; color:var(--b-mute); margin-top:6px;">{{ p.description }}</div>
      </div>
      <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.12em; color:var(--b-green-bright); text-transform:uppercase; white-space:nowrap;">VIEW &rarr;</div>
    </a>
  {% endfor %}
  <a href="/files/academic-resume.pdf" style="background:var(--b-bg); padding:28px 32px; text-decoration:none; color:var(--b-text); display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:24px;">
    <div>
      <div style="font-family:'Archivo', sans-serif; font-weight:900; font-size:20px; color:var(--b-text); text-transform:uppercase; letter-spacing:-0.01em;">Academic Summary</div>
      <div style="font-size:13px; color:var(--b-mute); margin-top:6px;">One-page PDF &mdash; measurables, GPA, coursework</div>
    </div>
    <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.12em; color:var(--b-green-bright); text-transform:uppercase; white-space:nowrap;">PDF &rarr;</div>
  </a>
</section>

{# ===== WHAT I CAN SEND ===== #}
<section style="padding:72px 56px; background:var(--b-bg-2); border-bottom:1px solid var(--b-line);">
  <div class="b-split" style="gap:56px; align-items:start;">
    <div>
      <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.14em; color:var(--b-green-bright); text-transform:uppercase; margin-bottom:16px;">/03 ON REQUEST</div>
      <h2 style="font-family:'Archivo', sans-serif; font-weight:900; font-size:56px; line-height:0.95; text-transform:uppercase; letter-spacing:-0.03em; margin:0; color:var(--b-text);">
        Ask and<br>it's sent.
      </h2>
      <p style="font-size:16px; color:var(--b-mute); margin-top:24px; max-width:420px;">
        Email or text and we will get it to you the same week. Coach references at {{ player.highSchool }} and {{ player.club }} can be provided on request.
      </p>
    </div>
    <div style="display:grid; gap:1px; background:var(--b-line); border:1px solid var(--b-line);">
      {% for item in [
        ['OFFICIAL TRANSCRIPT', 'Through the school registrar'],
        ['CURRENT GAME FILM', 'Unlisted links to recent games'],
        ['COACH REFERENCES', 'High school and club contacts'],
        ['PRACTICE / WORKOUT', 'Schedule a visit or a live viewing'],
        ['SCHEDULE', 'Upcoming high school and club games']
      ] %}
        <div style="background:var(--b-bg); padding:22px 26px;">
          <div style="font-family:'Archivo', sans-serif; font-weight:800; font-size:16px; color:var(--b-text); text-transform:uppercase; letter-spacing:0.02em;">{{ item[0] }}</div>
          <div style="font-size:13px; color:var(--b-mute); margin-top:5px;">{{ item[1] }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
