{# Page Header #}
<section class="section-football-hero">
    <div class="container">
        <div class="page-header-centered">
            <span class="label-eyebrow">Class of 2028</span>
            <h1>Football</h1>
            <p class="hero-subheadline">Two-sport history</p>
            <p class="supporting-text">Played football through sophomore year. Junior year off to focus on basketball.</p>
        </div>
    </div>
</section>

{# Player Information #}
<section class="section-measurables">
    <div class="container">
        <div class="measurables-grid">
            <div class="measurables-text">
                <h2>Player Information</h2>
                <div class="info-list">
                    <div class="info-item"><strong>Name:</strong> {{ player.name }}</div>
                    <div class="info-item"><strong>Class:</strong> {{ player.class }}</div>
                    <div class="info-item"><strong>Height / Weight:</strong> {{ player.height }} / {{ player.weight }} lbs</div>
                    <div class="info-item"><strong>School:</strong> {{ player.highSchool }}</div>
                    <div class="info-item"><strong>Football:</strong> Through sophomore year, while at Blue Valley Southwest</div>
                    <div class="info-item"><strong>Junior year:</strong> Off football to focus on basketball</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-content">
    <div class="container">
        <h2>Where it stands</h2>
        <p>Kevin played football through sophomore year, while he was at Blue Valley Southwest. He is taking junior year off from football to focus on basketball at Shawnee Mission West.</p>
        <p>No football season statistics are listed on this page.</p>
    </div>
</section>

{# Contact #}
<section class="section-coach-contact">
    <div class="container">
        <div class="contact-card">
            <h2>Contact</h2>
            <div class="contact-content">
                <div class="contact-block">
                    <h4>Family Contact</h4>
                    <p>For recruiting or academic questions, please reach out:</p>
                    <p><a href="mailto:{{ player.parentEmail }}">{{ player.parentEmail }}</a>{% if player.parentPhone %} · {{ player.parentPhone }}{% endif %}</p>
                </div>
                <div class="contact-cta">
                    <a href="mailto:{{ player.parentEmail }}?subject=Recruiting Inquiry – {{ player.name }}" class="btn-primary">Email About Recruiting</a>
                </div>
            </div>
        </div>
    </div>
</section>
