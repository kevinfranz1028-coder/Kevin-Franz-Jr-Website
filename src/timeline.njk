---
layout: base.njk
title: Timeline
description: Season-by-season basketball timeline for Kevin Franz Jr., Class of 2028 student-athlete.
permalink: /timeline/
---

<section class="section-page-header">
    <div class="container">
        <div class="page-header-centered">
            <span class="label-eyebrow">Timeline</span>
            <h1>Season by Season</h1>
            <p class="hero-subheadline">Elementary through high school, with school ball and AAU listed separately.</p>
        </div>
    </div>
</section>

<section class="cg-journey" aria-label="Journey">
    <header class="cg-band">
        <div>
            <p class="cg-kicker">Journey</p>
            <h2>Every team.</h2>
        </div>
    </header>
    {% include "journey-strip.njk" %}
</section>

{# Anything whose season does not match a Journey row still gets a link.
   Pages with listed: false stay published and are not shown twice. #}
{% set stageMatches = ['Elementary', 'Middle School', 'Middle School AAU', 'High School', 'AAU'] %}
{% set other = [] %}
{% for item in collections.timeline %}
    {% if item.data.listed != false and item.data.season not in stageMatches %}
        {% set _ = other.push(item) %}
    {% endif %}
{% endfor %}

<section class="section-content">
    <div class="container">
        {% if other | length %}
            <h2>Other</h2>
            <div class="updates-list" style="margin-bottom: 3rem;">
                {% for item in other | reverse %}
                <div class="update-card">
                    <div class="update-card-content">
                        <h3 class="update-card-title">{{ item.data.year }}</h3>
                        <time class="update-card-date">{{ item.data.grade }}{% if item.data.team %} &middot; {{ item.data.team }}{% endif %}</time>
                        <p class="update-card-summary">{{ item.data.summary }}</p>
                        {% if item.data.teams and item.data.teams.length %}
                        <ul class="timeline-team-list">
                            {% for t in item.data.teams %}
                            <li>
                                <a href="{{ item.url }}#{{ t.id }}">{{ t.when }} · {{ t.name }}{% if t.jersey %} #{{ t.jersey }}{% endif %}</a>
                                {% if t.honor %}<span>{{ t.honor }}</span>{% endif %}
                                {% if t.record or t.games or t.ppg or t.rpg or t.apg or t.spg %}
                                <span>{{ t | teamLine }}</span>
                                {% endif %}
                            </li>
                            {% endfor %}
                        </ul>
                        {% endif %}
                        <a href="{{ item.url }}" class="update-card-link">View season</a>
                    </div>
                </div>
                {% endfor %}
            </div>
        {% endif %}

        <p>
            <a href="/basketball/" class="back-link">← Back to Basketball Profile</a>
        </p>
    </div>
</section>
