<nav class="b-nav" aria-label="Primary">
  <a class="b-nav-brand" href="/">
    <span class="b-nav-mark">{{ player.jersey or "28" }}</span>
    <span>FRANZ JR</span>
  </a>
  <button class="b-nav-toggle" type="button" aria-expanded="false" aria-controls="b-nav-links" aria-label="Open menu">
    <span class="b-nav-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
    <span>Menu</span>
  </button>
  <div class="b-nav-links" id="b-nav-links">
    {% for link in navigation.links %}
      <a href="{{ link.url }}" {% if page.url == link.url %}class="active" aria-current="page"{% endif %}>{{ link.text }}</a>
    {% endfor %}
  </div>
</nav>
