<footer class="footer">
    <div class="container">
        <div class="footer-wrapper">
            <div class="footer-left">
                <p>{{ footer.copyright }}</p>
            </div>
            <div class="footer-right">
                <p>Email: <a href="mailto:{{ footer.email }}">{{ footer.email }}</a></p>
                <div class="footer-links">
                    {# Links with an empty url are TODO slots: skipped so no dead link shows. #}
                    {% set liveLinks = [] %}
                    {% for link in footer.links %}{% if link.url %}{% set _ = liveLinks.push(link) %}{% endif %}{% endfor %}
                    {% for link in liveLinks %}
                    <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.text }}</a>
                    {% if not loop.last %}<span>•</span>{% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</footer>
