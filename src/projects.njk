{# Storm log — chronological. Ratings and peak winds follow the official NWS
   damage surveys for each event. The previously listed "Greenfield, IA EF-2,
   Dec 10 2024" row was removed: it conflicted with the surveyed Greenfield
   event and could not be verified. #}
{% set storms = [
  { date: 'Mar 14, 2024', name: 'Winchester EF-3', wind: '155 mph', dur: '20 min', region: 'IN',
    notes: 'Late-season outbreak. Watched the storm-relative velocity couplet form on radar.' },
  { date: 'Apr 26, 2024', name: 'Lincoln EF-3',    wind: '158 mph', dur: '54 min', region: 'NE',
    notes: 'Followed the eastward path through the Omaha metro. Documented power flashes.' },
  { date: 'Apr 27, 2024', name: 'Sulphur EF-3',    wind: '160–165 mph', dur: '~13 min', region: 'OK',
    notes: 'Tracked organization on radar in real time. Logged hook-echo development. Short-lived but violent track through town.' }
] %}
{% set featured = storms | last %}

{# ===== HERO ===== #}
<section style="padding:80px 56px 56px; background:var(--b-bg); border-bottom:1px solid var(--b-line);">
  <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.14em; color:var(--b-green-bright); text-transform:uppercase; margin-bottom:24px;">&bull; PROJECTS &amp; PASSIONS</div>
  <h1 class="b-proj-h1" style="font-family:'Archivo', sans-serif; font-weight:900; font-size:150px; line-height:0.85; letter-spacing:-0.045em; text-transform:uppercase; margin:0; color:var(--b-text); max-width:90%;">
    What I'm<br><span style="-webkit-text-stroke:2px var(--b-green-bright); -webkit-text-fill-color:transparent;">obsessed</span> with.
  </h1>
  <p style="font-family:'Inter', sans-serif; font-size:18px; line-height:1.6; color:var(--b-mute); margin-top:32px; max-width:620px;">
    Off the floor I'm tracking storms, breaking down film, and teaching the game to younger kids. Three threads that run through everything.
  </p>
</section>

{# ===== STORM TRACKER ===== #}
<div class="b-section-head">
  <div class="b-section-head-left">
    <span class="b-section-tag">/01 STORM LOG</span>
    <h2 class="b-section-title">Tornado<br>tracker.</h2>
  </div>
  <span style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.1em; color:var(--b-mute); text-transform:uppercase;">
    RATINGS PER NWS DAMAGE SURVEYS
  </span>
</div>
<section class="b-storm" style="display:grid; grid-template-columns:1fr 1.4fr; border-bottom:1px solid var(--b-line); min-height:460px;">
  <div style="border-right:1px solid var(--b-line); background:var(--b-bg-2);">
    {% for s in storms %}
      {% set isActive = (s.name == featured.name) %}
      <div style="padding:20px 28px; {% if not loop.last %}border-bottom:1px solid var(--b-line);{% endif %} display:grid; grid-template-columns:92px minmax(0,1fr); align-items:center; gap:16px; background:{% if isActive %}var(--b-bg){% else %}transparent{% endif %}; border-left:{% if isActive %}3px solid var(--b-green-bright){% else %}3px solid transparent{% endif %};">
        <div style="font-family:'JetBrains Mono', monospace; font-size:11px; color:var(--b-mute);">{{ s.date }}</div>
        <div>
          <div style="font-family:'Archivo', sans-serif; font-weight:900; font-size:17px; color:var(--b-text); text-transform:uppercase; letter-spacing:-0.01em;">{{ s.name }}</div>
          <div style="font-family:'JetBrains Mono', monospace; font-size:10px; color:{% if isActive %}var(--b-green-bright){% else %}var(--b-mute){% endif %}; margin-top:4px; letter-spacing:0.08em;">{{ s.region }} &middot; {{ s.wind }}</div>
        </div>
      </div>
    {% endfor %}
  </div>
  <div style="padding:48px 56px; background:var(--b-bg); display:flex; flex-direction:column; justify-content:center; position:relative; overflow:hidden;">
    <div aria-hidden="true" style="position:absolute; top:50%; right:-100px; transform:translateY(-50%); width:500px; height:500px; opacity:0.15; pointer-events:none;">
      <svg viewBox="0 0 500 500" style="width:100%; height:100%;">
        <circle cx="250" cy="250" r="80"  fill="none" stroke="var(--b-green-bright)" stroke-width="1"></circle>
        <circle cx="250" cy="250" r="160" fill="none" stroke="var(--b-green-bright)" stroke-width="1"></circle>
        <circle cx="250" cy="250" r="240" fill="none" stroke="var(--b-green-bright)" stroke-width="1"></circle>
        <line x1="250" y1="0" x2="250" y2="500" stroke="var(--b-green-bright)" stroke-width="1"></line>
        <line x1="0" y1="250" x2="500" y2="250" stroke="var(--b-green-bright)" stroke-width="1"></line>
        <path d="M 280 220 Q 320 200 340 240 Q 360 280 320 290 Q 290 295 270 270 Q 260 250 280 220" fill="var(--b-amber)" opacity="0.6"></path>
        <circle cx="305" cy="255" r="6" fill="var(--b-red)"></circle>
      </svg>
    </div>
    <div style="position:relative; z-index:2;">
      <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.14em; color:var(--b-green-bright); text-transform:uppercase; margin-bottom:12px;">&bull; TRACKED EVENT</div>
      <h3 class="b-storm-title" style="font-family:'Archivo', sans-serif; font-weight:900; font-size:56px; line-height:0.9; letter-spacing:-0.03em; text-transform:uppercase; margin:0; color:var(--b-text);">{{ featured.name }}</h3>
      <div class="b-grid b-grid-4" style="border:1px solid var(--b-line); margin-top:28px; max-width:520px;">
        {% for cell in [['DATE', featured.date],['PEAK WIND', featured.wind],['ON GROUND', featured.dur],['STATE', featured.region]] %}
          <div style="padding:14px 16px; background:var(--b-bg-2);">
            <div style="font-family:'JetBrains Mono', monospace; font-size:9px; letter-spacing:0.14em; color:var(--b-mute); text-transform:uppercase;">{{ cell[0] }}</div>
            <div style="font-family:'Archivo', sans-serif; font-weight:800; font-size:15px; color:var(--b-text); margin-top:4px;">{{ cell[1] }}</div>
          </div>
        {% endfor %}
      </div>
      <p style="font-size:15px; line-height:1.6; color:var(--b-mute); margin-top:28px; max-width:480px;">{{ featured.notes }}</p>
    </div>
  </div>
</section>

{# ===== THREE THREADS ===== #}
<div class="b-section-head">
  <div class="b-section-head-left">
    <span class="b-section-tag">/02 PASSIONS</span>
    <h2 class="b-section-title">Three<br>threads.</h2>
  </div>
</div>
<section class="b-grid b-grid-3 b-grid-bordered">
  {% for p in [
    {tag:'/ WEATHER', title:'Forecasting &amp; storm tracking', body:'Severe-weather logs, radar study, and a long-running fascination with how the atmosphere actually behaves. The storm log above is the running record.'},
    {tag:'/ FILM', title:'Basketball IQ', body:'Film every week — our games, our opponents, and college guards and wings I want to emulate. Building a personal playbook of reads, counters, and decision-making frameworks.'},
    {tag:'/ MENTORSHIP', title:'Teaching the game', body:'Volunteer coach at youth camps, helping younger players with fundamentals, defensive rotations, and ball-handling. Teaching makes me a better player.'}
  ] %}
    <div style="background:var(--b-bg-2); padding:40px 32px; display:flex; flex-direction:column; min-height:300px;">
      <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.14em; color:var(--b-green-bright); text-transform:uppercase; margin-bottom:16px;">{{ p.tag }}</div>
      <h3 style="font-family:'Archivo', sans-serif; font-weight:900; font-size:26px; line-height:1.05; letter-spacing:-0.02em; text-transform:uppercase; margin:0; color:var(--b-text);">{{ p.title | safe }}</h3>
      <p style="font-size:14px; line-height:1.65; color:var(--b-mute); margin-top:16px; flex:1;">{{ p.body }}</p>
    </div>
  {% endfor %}
</section>
