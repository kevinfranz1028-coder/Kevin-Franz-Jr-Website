---
layout: broadcast.njk
title: Character
description: Community involvement, leadership, and core values of Kevin Franz Jr., Class of 2028 student-athlete.
permalink: /character/
active: character
---

{% set values = [
  { num: '/01', title: 'Team First',    description: 'Success is measured by what we achieve together — every screen, every sprint back, every box-out.' },
  { num: '/02', title: 'Accountability', description: 'Hold myself to high standards on and off the court — first one in, last one out.' },
  { num: '/03', title: 'Curiosity',     description: 'Always learning, always asking questions — film, books, weather charts, you name it.' },
  { num: '/04', title: 'Family',        description: 'Everything starts with the people who support me — parents, coaches, teammates.' }
] %}

{# ===== HERO ===== #}
<section class="cg-pagehead" style="padding:80px 56px; background:#000; border-bottom:8px solid #F5C400;">
  <div style="max-width:1100px;">
    <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.14em; color:var(--b-green-bright); text-transform:uppercase; margin-bottom:32px;">&bull; CHARACTER &amp; SERVICE</div>
    <h1 style="font-family:'Archivo', sans-serif; font-weight:900; font-size:96px; line-height:0.95; letter-spacing:-0.03em; margin:0; color:var(--b-text); text-transform:uppercase;">
      What I<br>stand for.
    </h1>
  </div>
</section>

{# ===== VALUES ===== #}
<section style="display:grid; grid-template-columns:repeat(4, 1fr); gap:1px; padding:1px; background:var(--b-line); border-bottom:1px solid var(--b-line);">
  {% for v in values %}
    <div style="background:var(--b-bg-2); padding:36px 28px; display:flex; flex-direction:column;">
      <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.14em; color:var(--b-green-bright); text-transform:uppercase; margin-bottom:20px;">{{ v.num }}</div>
      <h3 style="font-family:'Archivo', sans-serif; font-weight:900; font-size:32px; line-height:0.95; letter-spacing:-0.02em; text-transform:uppercase; margin:0 0 16px; color:var(--b-text);">{{ v.title }}</h3>
      <p style="font-size:14px; line-height:1.6; color:var(--b-mute); margin:0;">{{ v.description }}</p>
    </div>
  {% endfor %}
</section>

{# ===== SERVICE / LEADERSHIP ===== #}
<section style="display:grid; grid-template-columns:1fr 1fr; border-bottom:1px solid var(--b-line);">
  <div style="padding:72px 56px; border-right:1px solid var(--b-line); background:var(--b-bg-2);">
    <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.14em; color:var(--b-green-bright); text-transform:uppercase; margin-bottom:24px;">/02 SERVICE</div>
    <h2 style="font-family:'Archivo', sans-serif; font-weight:900; font-size:56px; line-height:0.95; letter-spacing:-0.03em; text-transform:uppercase; margin:0 0 32px; color:var(--b-text);">
      Giving<br>back.
    </h2>
    <div style="display:flex; flex-direction:column; gap:24px;">
      {% for s in [
        ['Youth Basketball Camps', 'Volunteers at youth basketball camps through school.']
      ] %}
        <div style="border-left:2px solid var(--b-green-bright); padding-left:20px;">
          <div style="font-family:'Archivo', sans-serif; font-weight:800; font-size:18px; color:var(--b-text); text-transform:uppercase; letter-spacing:-0.01em;">{{ s[0] }}</div>
          <p style="font-size:14px; line-height:1.6; color:var(--b-mute); margin:8px 0 0;">{{ s[1] }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
  <div style="padding:72px 56px; background:var(--b-bg);">
    <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.14em; color:var(--b-green-bright); text-transform:uppercase; margin-bottom:24px;">/03 LEADERSHIP</div>
    <h2 style="font-family:'Archivo', sans-serif; font-weight:900; font-size:56px; line-height:0.95; letter-spacing:-0.03em; text-transform:uppercase; margin:0 0 32px; color:var(--b-text);">
      Captain<br>energy.
    </h2>
    <div style="border:1px solid var(--b-line);">
      <div style="background:var(--b-bg-2); padding:24px 20px;">
        <div style="font-family:'Archivo', sans-serif; font-weight:900; font-size:32px; color:var(--b-green-bright); line-height:1; letter-spacing:-0.02em;">2024-25</div>
        <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.1em; color:var(--b-text); margin-top:6px; text-transform:uppercase;">Team Captain, Freshman A team</div>
      </div>
    </div>
  </div>
</section>
