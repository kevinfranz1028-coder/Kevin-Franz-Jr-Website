{# ===== VALUES ===== #}
<div class="b-section-head">
  <div class="b-section-head-left">
    <span class="b-section-tag">/01 VALUES</span>
    <h2 class="b-section-title">What I<br>stand for.</h2>
  </div>
</div>
<section style="display:grid; grid-template-columns:repeat(4, 1fr); gap:1px; padding:1px; background:var(--b-line); border-bottom:1px solid var(--b-line);">
  {% for v in values %}
    <div style="background:var(--b-bg-2); padding:36px 28px; min-height:340px; display:flex; flex-direction:column;">
      <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.14em; color:var(--b-green-bright); text-transform:uppercase; margin-bottom:20px;">{{ v.num }}</div>
      <h3 style="font-family:'Archivo', sans-serif; font-weight:900; font-size:32px; line-height:0.95; letter-spacing:-0.02em; text-transform:uppercase; margin:0 0 16px; color:var(--b-text);">{{ v.title }}</h3>
      <p style="font-size:14px; line-height:1.6; color:var(--b-mute); margin:0 0 16px;">{{ v.description }}</p>
      <p style="font-size:13px; line-height:1.65; color:var(--b-text); margin:auto 0 0; padding-top:16px; border-top:1px solid var(--b-line); opacity:0.85;">{{ v.detail }}</p>
    </div>
  {% endfor %}
</section>

