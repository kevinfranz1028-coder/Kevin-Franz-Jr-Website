<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title }} - {% endif %}Kevin Franz Jr.</title>
    <meta name="description" content="{{ description or 'Kevin Franz Jr. - Class of 2028 Guard & Student-Athlete. Basketball profile, academics, and recruiting information.' }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Bebas+Neue&family=IBM+Plex+Mono:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@1,8..60,500;1,8..60,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/style-modern.css">
    <link rel="stylesheet" href="/css/broadcast.css">
    <link rel="stylesheet" href="/css/mobile.css">
    <link rel="stylesheet" href="/css/cover-gold.css">
</head>
<body class="cg-body">
    <div class="b-root">
        {% include "b-nav.njk" %}
        <figure class="cg-profile-band">
            <img src="/images/kevin-profile.jpg" alt="Kevin Franz Jr. defending in a white number 3 jersey during a basketball game">
        </figure>
        <main>
            {{ content | safe }}
        </main>
        {% include "b-footer.njk" %}
    </div>
    <script src="/js/main.js"></script>
    <script src="/js/mobile-nav.js" defer></script>
</body>
</html>
