---
layout: broadcast.njk
active: basketball
---

{%- set hasBox = hasStats and points -%}

<section style="padding:64px 56px 40px; background:var(--b-bg); border-bottom:1px solid var(--b-line);">
  <a href="/basketball/" style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.12em; color:var(--b-green-bright); text-transform:uppercase; text-decoration:none;">&larr; FULL GAME LOG</a>
  <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.14em; color:var(--b-green-bright); text-transform:uppercase; margin:28px 0 18px;">
    &bull; {{ season }} &middot; {{ team }}{% if teamName %} &middot; {{ teamName }}{% endif %}
  </div>
  <h1 class="b-post-h1" style="font-family:'Archivo', sans-serif; font-weight:900; font-size:64px; line-height:0.95; letter-spacing:-0.035em; text-transform:uppercase; margin:0; color:var(--b-text);">
    {% if homeAway == 'away' %}at {% elif homeAway == 'neutral' %}vs {% else %}vs {% endif %}{{ opponent }}
  </h1>
  <div style="display:flex; flex-wrap:wrap; gap:10px 24px; align-items:baseline; margin-top:22px; font-family:'JetBrains Mono', monospace; font-size:12px; letter-spacing:0.08em; color:var(--b-mute); text-transform:uppercase;">
    <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
    {% if time %}<span>{{ time }}</span>{% endif %}
    {% if location %}<span>{{ location }}</span>{% endif %}
    {% if homeAway %}<span>{{ homeAway }}</span>{% endif %}
  </div>
  {% if result %}
  <div style="font-family:'Archivo', sans-serif; font-weight:900; font-size:44px; letter-spacing:-0.02em; margin-top:26px; color:{% if result.startsWith('W') %}var(--b-green-bright){% else %}var(--b-red){% endif %};">
    {{ result }}
  </div>
  {% else %}
  <div style="font-family:'JetBrains Mono', monospace; font-size:12px; letter-spacing:0.12em; color:var(--b-amber); text-transform:uppercase; margin-top:26px;">&#9675; NO RESULT RECORDED</div>
  {% endif %}
  {% if note %}
  <p style="font-family:'JetBrains Mono', monospace; font-size:11px; line-height:1.6; color:var(--b-mute); margin:18px 0 0; max-width:680px;">{{ note }}</p>
  {% endif %}
</section>

{% if hasBox %}
<section class="b-statgrid">
  {% for cell in [
    ['PTS', points], ['REB', rebounds], ['AST', assists],
    ['STL', steals], ['BLK', blocks], ['TO', turnovers],
    ['FG', fg], ['3PT', threePt], ['FT', ft], ['PF', fouls]
  ] %}
    {% if cell[1] %}
    <div class="b-statgrid-cell" style="min-height:120px;">
      <div class="b-statgrid-label">{{ cell[0] }}</div>
      <div><div class="b-statgrid-value" style="font-size:40px;">{{ cell[1] }}</div></div>
    </div>
    {% endif %}
  {% endfor %}
</section>
<section style="padding:20px 56px 28px; background:var(--b-bg-2); border-bottom:1px solid var(--b-line); font-family:'JetBrains Mono', monospace; font-size:10px; letter-spacing:0.1em; color:var(--b-mute); text-transform:uppercase;">
  KEVIN FRANZ JR.{% if jersey %} &middot; #{{ jersey }}{% endif %} &middot; BOX SCORE FROM THE GAMECHANGER TEAM LOG
</section>
{% elif hasStats == false %}
<section style="padding:36px 56px; background:var(--b-bg-2); border-bottom:1px solid var(--b-line);">
  <div style="font-family:'JetBrains Mono', monospace; font-size:12px; letter-spacing:0.12em; color:var(--b-amber); text-transform:uppercase;">
    &#9675; KEVIN DID NOT APPEAR IN THE BOX SCORE FOR THIS GAME
  </div>
  <p style="font-size:14px; color:var(--b-mute); margin:12px 0 0; max-width:620px;">
    The team result is recorded above. No individual stats are published for this game.
  </p>
</section>
{% endif %}

{% if content | trim | length %}
<section class="b-prose" style="padding:40px 56px; background:var(--b-bg); border-bottom:1px solid var(--b-line);">
  <div style="max-width:760px;">{{ content | safe }}</div>
</section>
{% endif %}

<section style="padding:36px 56px; background:var(--b-bg-2); display:flex; flex-wrap:wrap; gap:24px;">
  <a href="/basketball/" style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.12em; color:var(--b-green-bright); text-transform:uppercase; text-decoration:none;">&larr; FULL GAME LOG</a>
  <a href="/timeline/" style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.12em; color:var(--b-mute); text-transform:uppercase; text-decoration:none;">SEASON TIMELINE &rarr;</a>
</section>
