---
layout: broadcast.njk
active: updates
---

<article>
  <section style="padding:72px 56px 48px; background:var(--b-bg); border-bottom:1px solid var(--b-line);">
    <a href="/updates/" style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.12em; color:var(--b-green-bright); text-transform:uppercase; text-decoration:none;">&larr; ALL UPDATES</a>
    <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.14em; color:var(--b-green-bright); text-transform:uppercase; margin:28px 0 20px;">&bull; {{ type or 'UPDATE' }}</div>
    <h1 class="b-post-h1" style="font-family:'Archivo', sans-serif; font-weight:900; font-size:68px; line-height:0.95; letter-spacing:-0.035em; text-transform:uppercase; margin:0; color:var(--b-text); max-width:900px;">{{ title }}</h1>
    <time datetime="{{ date | htmlDateString }}" style="display:block; font-family:'JetBrains Mono', monospace; font-size:12px; letter-spacing:0.1em; color:var(--b-mute); text-transform:uppercase; margin-top:28px;">{{ date | readableDate }}</time>
    {% if summary %}
    <p style="font-family:'Inter', sans-serif; font-size:18px; line-height:1.6; color:var(--b-mute); margin-top:24px; max-width:720px;">{{ summary }}</p>
    {% endif %}
  </section>

  {% if coverImage %}
  <div style="border-bottom:1px solid var(--b-line);">
    <img src="{{ coverImage }}" alt="{{ title }}" loading="lazy" style="width:100%; max-height:520px; object-fit:cover; display:block;">
  </div>
  {% endif %}

  <section class="b-prose" style="padding:56px; background:var(--b-bg); border-bottom:1px solid var(--b-line);">
    <div style="max-width:760px;">
      {{ content | safe }}
    </div>
  </section>

  <section style="padding:40px 56px; background:var(--b-bg-2);">
    <a href="/updates/" style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.12em; color:var(--b-green-bright); text-transform:uppercase; text-decoration:none;">&larr; BACK TO ALL UPDATES</a>
  </section>
</article>
