    <div style="aspect-ratio:16/9; background:var(--b-bg-3); display:grid; place-items:center; padding:32px;">
      <div style="font-family:'Archivo', sans-serif; font-weight:900; font-size:28px; line-height:1.05; letter-spacing:-0.02em; text-transform:uppercase; color:var(--b-text); text-align:center;">
        New highlights<br>coming soon.
      </div>
    </div>
    <div style="padding:24px 28px;">
      <p style="font-size:14px; color:var(--b-mute); margin:0;">Middle school camp film is on the <a href="/timeline/2023-2024/" style="color:var(--b-green-bright);">2023–24 timeline</a>.</p>
    </div>
  </div>
</section>

