---
layout: broadcast.njk
title: Basketball
description: Junior year. Shawnee Mission West Vikings varsity, 2026-27.
permalink: /basketball/
active: basketball
---

<section class="cg-pagehead bb-hero">
  <img class="bb-hero-photo" src="{{ basketballSeason.heroPhoto }}" alt="{{ basketballSeason.heroPhotoAlt }}">
  <div class="bb-hero-shade"></div>
  <div class="bb-hero-grid">
    <div>
      <p class="bb-kicker">{{ basketballSeason.kicker }}</p>
      <h1>Shawnee<br>Mission<br><span>West.</span></h1>
      <p class="bb-dek">{{ basketballSeason.mascot }} &middot; {{ basketballSeason.level }} &middot; {{ basketballSeason.seasonLabel }}</p>
    </div>
    <div class="cg-paper bb-card">
      <p class="bb-card-name">{{ player.name }}</p>
      <p class="bb-card-meta">{{ basketballSeason.school }} {{ basketballSeason.mascot }}</p>
      <p class="bb-card-meta">{{ basketballSeason.level }} &middot; {{ basketballSeason.seasonLabel }}</p>
      <p class="bb-honor">{{ basketballSeason.honor }}</p>
      <a class="bb-card-link" href="{{ basketballSeason.jvSeasonHref }}">{{ basketballSeason.jvSeasonLabel }} &rarr;</a>
    </div>
  </div>
</section>

<div class="b-section-head">
  <div class="b-section-head-left">
    <span class="b-section-tag">/01 NUMBERS</span>
    <h2 class="b-section-title">Varsity stats.</h2>
  </div>
</div>
<section class="bb-soon" aria-label="Varsity stats coming soon">
  <strong>Coming soon.</strong>
  <p>No varsity stats are posted yet.</p>
</section>

<div class="b-section-head">
  <div class="b-section-head-left">
    <span class="b-section-tag">/02 SCHEDULE</span>
    <h2 class="b-section-title">{{ basketballSeason.seasonLabel }}.</h2>
  </div>
</div>
<section class="bb-schedule" aria-label="Varsity schedule">
  {% if smWestVarsitySchedule and smWestVarsitySchedule.games and smWestVarsitySchedule.games.length %}
  <div class="bb-row bb-row-head">
    <div>Date</div>
    <div>Opponent</div>
    <div>Site</div>
    <div>Time</div>
    <div>Location</div>
  </div>
  {% for game in smWestVarsitySchedule.games %}
  <article class="bb-row">
    <div class="bb-date">{{ game.displayDate }}</div>
    <div class="bb-opp">{{ game.opponent }}</div>
    <div class="bb-site">{{ game.homeAway or "Site not listed" }}</div>
    <div class="bb-time">{{ game.time }}</div>
    <div class="bb-where">{{ game.location or "Location not listed" }}</div>
    {% if game.note %}<p class="bb-note">{{ game.note }}</p>{% endif %}
  </article>
  {% endfor %}
  <p class="bb-source">
    Source: <a href="{{ smWestVarsitySchedule.sourceUrl }}">{{ smWestVarsitySchedule.sourceName }}</a>.
    Calendar page: <a href="{{ smWestVarsitySchedule.calendarPage }}">Shawnee Mission West on Bound</a>.
    {% if smWestVarsitySchedule.fetchedAt %}Fetched {{ smWestVarsitySchedule.fetchedAt }}.{% endif %}
  </p>
  {% else %}
  <div class="bb-soon">
    <strong>Schedule unavailable.</strong>
    <p>The saved schedule file has no games. Nothing is filled in by hand.</p>
  </div>
  {% endif %}
</section>

<div class="b-section-head">
  <div class="b-section-head-left">
    <span class="b-section-tag">/03 FILM</span>
    <h2 class="b-section-title">Highlights.</h2>
  </div>
</div>
<section class="bb-soon" aria-label="Highlights coming soon">
  <strong>Coming soon.</strong>
</section>

<section class="bb-contact">
  <div>
    <p class="bb-kicker bb-kicker-ink">/04 CONTACT</p>
    <h2>For coaches.</h2>
    <p>The {{ basketballSeason.jvSeasonLabel }} season, with its stats and games, is on the journey.</p>
    <a class="bb-card-link" href="{{ basketballSeason.jvSeasonHref }}">{{ basketballSeason.jvSeasonLabel }} &rarr;</a>
  </div>
  <div class="bb-contact-links">
    <a href="mailto:{{ player.parentEmail }}">{{ player.parentEmail }}</a>
    <a href="tel:{{ player.parentPhone }}">{{ player.parentPhone }}</a>
  </div>
</section>
