{# ===== HERO ===== #}
<section style="position:relative; min-height:520px; background:var(--b-bg); overflow:hidden; border-bottom:1px solid var(--b-line);">
  <img src="/images/banner/large_Copy_of_618_A3075_2_Enhanced_NR_0a0a68195a.jpg" alt="" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0.55;">
  <div style="position:absolute; inset:0; background:linear-gradient(180deg, rgba(11,13,16,0.4) 0%, rgba(11,13,16,0.85) 70%, var(--b-bg) 100%);"></div>
  <div style="position:relative; z-index:2; padding:80px 56px; display:grid; grid-template-columns:1.4fr 1fr; gap:48px; align-items:end; min-height:520px;">
    <div>
      <div style="display:flex; align-items:center; gap:10px; font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.14em; color:var(--b-green-bright); text-transform:uppercase; margin-bottom:24px;">
        <span>&bull;</span> BASKETBALL &middot; 2025–26
      </div>
      <h1 style="font-family:'Archivo', sans-serif; font-weight:900; font-size:160px; line-height:0.85; letter-spacing:-0.045em; text-transform:uppercase; margin:0; color:var(--b-text);">
        The<br><span style="-webkit-text-stroke:2px var(--b-green-bright); -webkit-text-fill-color:transparent;">Game.</span>
      </h1>
      <p style="font-family:'Inter', sans-serif; font-size:18px; line-height:1.6; color:var(--b-mute); margin-top:32px; max-width:560px;">
        Stats, schedule, film, and recruiting profiles.
      </p>
    </div>
    <div style="background:var(--b-bg-2); border:1px solid var(--b-line); padding:28px;">
      <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:20px;">
        <div>
          <div style="font-family:'Archivo', sans-serif; font-weight:900; font-size:22px; color:var(--b-text); text-transform:uppercase; letter-spacing:-0.01em;">{{ player.name }}</div>
          <div style="font-family:'JetBrains Mono', monospace; font-size:11px; color:var(--b-mute); letter-spacing:0.1em; margin-top:4px;">#{{ player.jersey }} &middot; COMBO GUARD</div>
        </div>
        <div style="font-family:'Archivo', sans-serif; font-weight:900; font-size:48px; color:var(--b-green-bright); line-height:1;">{{ player.jersey }}</div>
      </div>
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--b-line); border:1px solid var(--b-line);">
        {% for cell in [['HT', player.height], ['WT', player.weight], ['CLASS', player.class], ['HS', 'BVSW'], ['AAU', '3SSB'], ['GPA', player.gpa]] %}
          <div style="background:var(--b-bg); padding:14px;">
            <div style="font-family:'JetBrains Mono', monospace; font-size:10px; letter-spacing:0.14em; color:var(--b-mute); text-transform:uppercase;">{{ cell[0] }}</div>
            <div style="font-family:'Archivo', sans-serif; font-weight:800; font-size:18px; color:var(--b-text); margin-top:4px;">{{ cell[1] }}</div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{# ===== STATS ===== #}
<div class="b-section-head">
  <div class="b-section-head-left">
    <span class="b-section-tag">/01 NUMBERS</span>
    <h2 class="b-section-title">2025–26.</h2>
  </div>
  <span style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.1em; color:var(--b-mute); text-transform:uppercase;">
    BVSW JV &middot; 7 GP &middot; <span style="color:var(--b-green-bright);">5W</span>–2L
  </span>
</div>
<section style="display:grid; grid-template-columns:repeat(5, 1fr); gap:1px; background:var(--b-line); border-bottom:1px solid var(--b-line);">
  {% for s in stats2526 %}
    <div style="padding:28px; background:var(--b-bg); min-height:160px; display:flex; flex-direction:column; justify-content:space-between; position:relative;">
      <div style="display:flex; justify-content:space-between; align-items:flex-start;">
        <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:var(--b-mute);">{{ s.label }}</div>
        <div style="font-family:'JetBrains Mono', monospace; font-size:10px; letter-spacing:0.1em; color:var(--b-green-bright); background:rgba(34,197,94,0.1); padding:2px 8px;">{{ s.rank }}</div>
      </div>
      <div style="font-family:'Archivo', sans-serif; font-weight:900; font-size:56px; line-height:1; letter-spacing:-0.04em; color:var(--b-text);">{{ s.value }}</div>
    </div>
  {% endfor %}
</section>

{# ===== SCHEDULE ===== #}
<div class="b-section-head">
  <div class="b-section-head-left">
    <span class="b-section-tag">/02 SCHEDULE</span>
    <h2 class="b-section-title">Season.</h2>
  </div>
</div>
<section style="border-bottom:1px solid var(--b-line);">
  <div style="display:grid; grid-template-columns:90px 1fr 90px 110px 130px; padding:14px 48px; border-bottom:1px solid var(--b-line); font-family:'JetBrains Mono', monospace; font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:var(--b-mute); background:var(--b-bg-2);">
    <div>DATE</div><div>OPPONENT</div><div>LOC</div><div>STATUS</div><div>RESULT</div>
  </div>
  {% for g in schedule %}
    <div style="display:grid; grid-template-columns:90px 1fr 90px 110px 130px; padding:18px 48px; {% if not loop.last %}border-bottom:1px solid var(--b-line);{% endif %} align-items:center; background:{% if g.upcoming %}transparent{% else %}var(--b-bg){% endif %};">
      <div style="font-family:'JetBrains Mono', monospace; font-size:13px; color:var(--b-mute); letter-spacing:0.04em;">{{ g.date }}</div>
      <div style="font-family:'Archivo', sans-serif; font-weight:700; font-size:16px; color:var(--b-text);">{{ g.opp }}</div>
      <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.1em; color:var(--b-mute); text-transform:uppercase;">{{ g.loc }}</div>
      <div style="font-family:'JetBrains Mono', monospace; font-size:10px; letter-spacing:0.12em; text-transform:uppercase; color:{% if g.upcoming %}var(--b-amber){% else %}var(--b-green-bright){% endif %};">{% if g.upcoming %}&#9675; UPCOMING{% else %}&bull; FINAL{% endif %}</div>
      <div style="font-family:'Archivo', sans-serif; font-weight:800; font-size:15px; letter-spacing:0.04em; color:{% if g.result.startsWith('W') %}var(--b-green-bright){% elif g.result.startsWith('L') %}var(--b-red){% else %}var(--b-mute){% endif %};">{{ g.result }}</div>
    </div>
  {% endfor %}
</section>

{# ===== HIGHLIGHTS ===== #}
<div class="b-section-head">
  <div class="b-section-head-left">
    <span class="b-section-tag">/03 FILM</span>
    <h2 class="b-section-title">Highlights.</h2>
  </div>
</div>
<section style="padding:40px 48px; border-bottom:1px solid var(--b-line); display:grid; grid-template-columns:1fr 1fr; gap:24px;">
  {% for h in highlights %}
    <a href="https://www.youtube.com/watch?v={{ h.videoId }}" target="_blank" rel="noopener" style="background:var(--b-bg-2); border:1px solid var(--b-line); text-decoration:none; color:inherit; display:block;">
      <div style="aspect-ratio:16/9; background:var(--b-bg-3); position:relative; overflow:hidden;">
        <img src="https://i.ytimg.com/vi/{{ h.videoId }}/hqdefault.jpg" alt="{{ h.title }}" style="width:100%; height:100%; object-fit:cover;">
        <div style="position:absolute; inset:0; background:linear-gradient(0deg, rgba(11,13,16,0.6), transparent 60%);"></div>
        <div style="position:absolute; inset:0; display:grid; place-items:center;">
          <div style="width:80px; height:80px; background:var(--b-green-bright); display:grid; place-items:center; clip-path:polygon(8% 0, 100% 0, 92% 100%, 0% 100%);">
            <div style="width:0; height:0; border-top:14px solid transparent; border-bottom:14px solid transparent; border-left:20px solid var(--b-bg); margin-left:6px;"></div>
          </div>
        </div>
        <div style="position:absolute; top:14px; left:14px; font-family:'JetBrains Mono', monospace; font-size:10px; letter-spacing:0.14em; text-transform:uppercase; background:rgba(11,13,16,0.7); color:var(--b-text); padding:6px 10px; border-left:2px solid var(--b-green-bright);">HIGHLIGHT REEL</div>
      </div>
      <div style="padding:24px 28px;">
        <h3 style="font-family:'Archivo', sans-serif; font-weight:900; font-size:22px; margin:0 0 8px; text-transform:uppercase; letter-spacing:-0.02em;">{{ h.title }}</h3>
        <p style="font-size:14px; color:var(--b-mute); margin:0;">{{ h.description }}</p>
      </div>
    </a>
  {% endfor %}
</section>

{# ===== RECRUITING ===== #}
<section style="padding:80px 48px; background:var(--b-bg-2);">
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:start;">
    <div>
      <div style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.14em; color:var(--b-green-bright); text-transform:uppercase; margin-bottom:16px;">/04 RECRUITING</div>
      <h2 style="font-family:'Archivo', sans-serif; font-weight:900; font-size:64px; line-height:0.95; text-transform:uppercase; letter-spacing:-0.03em; margin:0;">
        For coaches<br>&amp; <span style="-webkit-text-stroke:2px var(--b-green-bright); -webkit-text-fill-color:transparent;">scouts.</span>
      </h2>
      <p style="font-size:16px; color:var(--b-mute); margin-top:24px; max-width:420px;">
        Find Kevin's profile across major recruiting platforms. For direct inquiries, contact the family.
      </p>
      <div style="display:flex; flex-direction:column; gap:8px; margin-top:32px;">
        <a href="mailto:{{ player.parentEmail }}" style="color:var(--b-text); font-family:'Archivo', sans-serif; font-weight:800; font-size:20px; text-decoration:none; border-bottom:1px solid var(--b-line); padding-bottom:10px;">{{ player.parentEmail }}</a>
        <a href="tel:{{ player.parentPhone }}" style="color:var(--b-text); font-family:'Archivo', sans-serif; font-weight:800; font-size:20px; text-decoration:none; border-bottom:1px solid var(--b-line); padding-bottom:10px;">{{ player.parentPhone }}</a>
      </div>
    </div>
    <div style="display:grid; gap:1px; background:var(--b-line); border:1px solid var(--b-line);">
      {% for link in [
        ['PREPHOOPS', 'Player profile and rankings', '#'],
        ['NCSA SPORTS', 'Complete recruiting profile', '#'],
        ['SPORTS PASSPORTS', 'Tournament history and stats', '#'],
        ['INSTAGRAM', '@kfranzjr2028', 'https://instagram.com/kfranzjr2028']
      ] %}
        <a href="{{ link[2] }}" {% if link[2] != '#' %}target="_blank" rel="noopener"{% endif %} style="display:flex; justify-content:space-between; align-items:center; padding:24px 28px; background:var(--b-bg); color:var(--b-text); text-decoration:none;">
          <div>
            <div style="font-family:'Archivo', sans-serif; font-weight:900; font-size:18px; text-transform:uppercase; letter-spacing:0.02em;">{{ link[0] }}</div>
            <div style="font-size:13px; color:var(--b-mute); margin-top:4px;">{{ link[1] }}</div>
          </div>
          <span style="font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.12em; color:var(--b-green-bright);">VIEW &rarr;</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
